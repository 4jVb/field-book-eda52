<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Fecha de inicio del experimento -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/toy_dialog_start_date_label"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/toy_dialog_start_date_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/toy_dialog_select_date" />

            <Button
                android:id="@+id/toy_dialog_start_date_clear_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/toy_dialog_clear" />
        </LinearLayout>

        <!-- Time of Year -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/toy_dialog_toy_label"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/toy_dialog_toy_type_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/toy_dialog_toy_value_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" />

        <CheckBox
            android:id="@+id/toy_dialog_auto_toy_cb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/toy_dialog_auto_calculate"
            android:layout_marginBottom="12dp" />

        <!-- Event -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/toy_dialog_event_label"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/toy_dialog_event_type_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/toy_dialog_event_value_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <!-- Traits seleccionados -->
        <TextView
            android:id="@+id/toy_dialog_traits_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/toy_dialog_traits_label"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/toy_dialog_traits_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/toy_dialog_traits_all_selected"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/toy_dialog_traits_rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="200dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>
